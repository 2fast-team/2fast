<ContentDialog
    x:Class="Project2FA.Uno.Views.WebDAVAuthContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Project2FA.Uno.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="WebDAVAuthContentDialogMain"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsSuccessFlag, Mode=OneWay}"
    CloseButtonClick="ContentDialog_CloseButtonClick">

    <Grid MinWidth="360" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Server address (always visible, disabled during polling) -->
        <TextBox
            Grid.Row="0"
            x:Uid="WebDAVAuthServerAddressBox"
            Header="Server address"
            Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="https://cloud.example.com"
            IsEnabled="{x:Bind ViewModel.IsNotPolling, Mode=OneWay}"/>

        <!-- Login Flow v2 panel -->
        <StackPanel
            Grid.Row="1"
            Spacing="12">

            <TextBlock
                x:Uid="WebDAVAuthLoginFlowV2DescText"
                Text="Click the button below to open the sign-in page in your browser. Return here once you have logged in."
                TextWrapping="Wrap"/>

            <!-- Start button (only shown before polling starts) -->
            <Button
                x:Uid="WebDAVAuthStartBrowserLoginButton"
                HorizontalAlignment="Stretch"
                Content="Open login in browser"
                Command="{x:Bind ViewModel.StartLoginFlowV2Command}"
                Visibility="{x:Bind ViewModel.IsPollingInverse, Mode=OneWay}"/>

            <!-- Polling indicator (shown while waiting for browser login) -->
            <StackPanel
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsPolling, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsPollingFlag, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Center"/>
                <TextBlock
                    x:Uid="WebDAVAuthWaitingText"
                    HorizontalAlignment="Center"
                    Text="Waiting for login in browser..."
                    TextWrapping="Wrap"/>
                <!-- Reopen browser link during polling -->
                <HyperlinkButton
                    x:Name="OpenBrowserButton"
                    HorizontalAlignment="Center"
                    Click="OpenBrowserButton_Click">
                    <HyperlinkButton.Content>
                        <TextBlock
                            x:Uid="WebDAVAuthStartBrowserLoginButton"
                            Text="Open login in browser"/>
                    </HyperlinkButton.Content>
                </HyperlinkButton>
            </StackPanel>

            <!-- Success indicator -->
            <StackPanel
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay}">
                <FontIcon Glyph="&#xE73E;" FontSize="32" HorizontalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                <TextBlock
                    x:Uid="WebDAVAuthSuccessText"
                    HorizontalAlignment="Center"
                    Text="Login successful!"/>
            </StackPanel>

            <!-- Error message -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsError, Mode=OneWay}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsClosable="False"/>
        </StackPanel>
    </Grid>
</ContentDialog>